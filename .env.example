# Variaveis de ambiente do backend FrioVale. Copie para .env (ou configure no servidor) e preencha.
# NUNCA versione o arquivo com valores reais.

# Banco de dados (Spring le automaticamente estas variaveis)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT (HS256) - minimo de 32 caracteres aleatorios
FRIOVALE_JWT_SECRET=

# [Seguranca - 2FA] chave AES-256 que cifra o segredo TOTP no banco: 32 bytes em Base64
# Gerar no PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Gerar no Linux/macOS: openssl rand -base64 32
FRIOVALE_OTP_ENCRYPTION_KEY=

# [Seguranca] codigo de missao enviado pelo professor (aparece nos logs de bloqueio)
MISSION_CODE=

# Senha do gestor inicial (usada so quando o banco esta vazio)
FRIOVALE_BOOTSTRAP_ADMIN_PASSWORD=

# Integracoes ja existentes
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FrioVale
THINGSPEAK_EVENT_CHANNEL_ID=
THINGSPEAK_EVENT_API_KEY=
